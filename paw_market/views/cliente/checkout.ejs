<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/stylesheets/main.css">
</head>

<body>

    <!-- Barra lateral -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <span class="brand-super">Supermarket</span>
            <span class="brand-hub">HUB</span>
        </div>
        <nav class="sidebar-nav">
            <a href="/cliente" class="sidebar-link">Início</a>
            <a href="/cliente/products" class="sidebar-link">Produtos</a>
            <a href="/cliente/cart" class="sidebar-link">Carrinho</a>
            <a href="/cliente/orders" class="sidebar-link">Minhas Encomendas</a>
            <a href="/cliente/profile" class="sidebar-link">Perfil</a>
        </nav>
        <div class="sidebar-footer">
            <a href="/logout" class="sidebar-logout">Sair da Conta</a>
        </div>
    </aside>

    <!-- Conteúdo principal -->
    <div class="page-wrapper">
        <main class="main-container">

            <h1 style="color: #1a237e; margin-bottom: 24px;">Finalizar Encomenda</h1>

            <div style="display: grid; grid-template-columns: 1fr 380px; gap: 24px;">

                <!-- RESUMO DOS PRODUTOS -->
                <div
                    style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                    <h2 style="font-size: 18px; color: #1f2937; margin-bottom: 16px;">Resumo do Pedido</h2>

                    <% cartItems.forEach(function(item) { %>
                        <div
                            style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #f0f0f0;">
                            <div>
                                <span style="font-weight: 600;">
                                    <%= item.product.name %>
                                </span>
                                <span style="color: #888; font-size: 13px; margin-left: 8px;">x<%= item.quantity %>
                                        </span>
                            </div>
                            <span style="font-weight: 700; color: #1a237e;">
                                <%= item.subtotal.toFixed(2) %> €
                            </span>
                        </div>
                        <% }) %>

                            <div
                                style="display: flex; justify-content: space-between; align-items: center; padding: 16px 0; margin-top: 8px;">
                                <span style="font-size: 16px; font-weight: 600;">Subtotal:</span>
                                <span style="font-size: 20px; font-weight: 800; color: #1a237e;">
                                    <%= total.toFixed(2) %> €
                                </span>
                            </div>
                </div>

                <!-- FORMULÁRIO DE CHECKOUT -->
                <div
                    style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                    <h2 style="font-size: 18px; color: #1f2937; margin-bottom: 20px;">Dados da Entrega</h2>

                    <form method="POST" action="/cliente/checkout">

                        <!-- Método de entrega -->
                        <div style="margin-bottom: 20px;">
                            <label
                                style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Método
                                de Entrega</label>

                            <% if (supermarket && supermarket.deliveryMethods && supermarket.deliveryMethods.pickup) {
                                %>
                                <label
                                    style="display: flex; align-items: center; gap: 10px; padding: 14px; border: 2px solid #e8eaf6; border-radius: 10px; margin-bottom: 8px; cursor: pointer;">
                                    <input type="radio" name="deliveryMethod" value="pickup" checked
                                        style="accent-color: #1a237e;">
                                    <div>
                                        <span style="font-weight: 600;">Levantamento em Loja</span>
                                        <span style="display: block; font-size: 12px; color: #888;">Grátis</span>
                                    </div>
                                </label>
                                <% } %>

                                    <% if (supermarket && supermarket.deliveryMethods &&
                                        supermarket.deliveryMethods.courier) { %>
                                        <label
                                            style="display: flex; align-items: center; gap: 10px; padding: 14px; border: 2px solid #e8eaf6; border-radius: 10px; cursor: pointer;">
                                            <input type="radio" name="deliveryMethod" value="courier"
                                                style="accent-color: #1a237e;">
                                            <div>
                                                <span style="font-weight: 600;">Entrega por Estafeta</span>
                                                <span style="display: block; font-size: 12px; color: #888;">+ <%=
                                                        supermarket.deliveryCost ? supermarket.deliveryCost.toFixed(2)
                                                        : '0.00' %> €</span>
                                            </div>
                                        </label>
                                        <% } %>
                        </div>

                        <!-- Notas -->
                        <div style="margin-bottom: 20px;">
                            <label
                                style="display: block; font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 8px;">Notas
                                (Opcional)</label>
                            <textarea name="notes" rows="3" placeholder="Ex: Tocar à campainha..."
                                style="width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 8px; font-size: 14px; resize: vertical; font-family: inherit;"></textarea>
                        </div>

                        <!-- Botão -->
                        <button type="submit"
                            style="width: 100%; padding: 14px; background: #1a237e; color: white; border: none; border-radius: 10px; font-size: 16px; font-weight: 700; cursor: pointer;">
                            Confirmar Encomenda
                        </button>
                    </form>

                    <a href="/cliente/cart"
                        style="display: block; text-align: center; margin-top: 12px; color: #888; font-size: 13px; text-decoration: none;">
                        ← Voltar ao Carrinho
                    </a>
                </div>

            </div>

        </main>
    </div>

</body>

</html>