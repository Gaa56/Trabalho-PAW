<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <!-- Ligação ao novo CSS exclusivo do Dashboard com largura limitada! -->
    <link rel="stylesheet" href="/stylesheets/main.css">
    <style>
        .status-entregue { background-color: #e8f5e9; color: #2e7d32; }
        .status-cancelada { background-color: #ffebee; color: #c62828; }
        .status-default { background-color: #e3f2fd; color: #1565c0; }
        .status-badge-inline {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <!-- Barra lateral -->
    <div class="sidebar">
        <!-- Logotipo no topo do sidebar -->
        <div class="sidebar-brand">
            <span class="brand-super">Supermarket</span>
            <span class="brand-hub">HUB</span>
        </div>

        <!-- Links de Navegação -->
        <nav class="sidebar-nav">
            <a href="/cliente" class="sidebar-link active">Início</a>
            <a href="/cliente/products" class="sidebar-link">Produtos</a>
            <a href="/cliente/cart" class="sidebar-link">Carrinho</a>
            <a href="/cliente/orders" class="sidebar-link">Minhas Encomendas</a>
            <a href="/cliente/profile" class="sidebar-link">Perfil</a>
        </nav>

        <!-- Botão de logout no fundo do sidebar -->
        <div class="sidebar-footer">
            <a href="/logout" class="sidebar-logout">Sair da Conta</a>
        </div>
    </div>


    <!-- Conteúdo principal -->
    <div class="page-wrapper">

        <!-- ESPAÇO CENTRAL DO DASHBOARD -->
        <main class="main-container">

            <!-- Banner de boas-vindas -->
            <section class="hero-banner">
                <div class="hero-content">
                    <h1 class="hero-title">Bem-vindo, <%= user.name.split(' ')[0] %></h1> 
                </div>
                <img src="/images/ClientHome.png" alt="Cliente Home Logo" class="hero-image">
            </section>

            <!-- Estatísticas de total encomendas no "Inicio" -->
            <section style="display: flex; gap: 20px; margin-top: 30px; flex-wrap: wrap;">
                <div style="background: white; border-radius: 12px; padding: 24px; flex: 1; min-width: 200px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                    <h3 style="margin: 0 0 8px 0; color: #666; font-size: 14px;">Total de Encomendas</h3>
                    <p style="margin: 0; font-size: 32px; font-weight: bold; color: #1a237e;"><%= totalOrders %></p>
                </div>
            </section>

            <!-- Produtos mais comprados -->
            <% if (topProducts && topProducts.length > 0) { %>  <!-- Caso tenha feita uma encomenda é que isto aparece -->
            <section style="margin-top: 30px;">
                <h2 style="color: #1a237e; margin-bottom: 16px;">Produtos Mais Comprados</h2>
                <div style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                <!-- Tabela com as estatisticas dos produtos mais comprados -->
                    <table style="width: 100%; border-collapse: collapse;"> 
                        <thead>
                            <tr style="border-bottom: 2px solid #eee;">
                                <th style="text-align: left; padding: 10px; color: #666;">Produto</th>
                                <th style="text-align: right; padding: 10px; color: #666;">Quantidade</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% topProducts.forEach(function(p) { %> <!-- Vai mostrar os produtos mais comprados -->
                            <tr style="border-bottom: 1px solid #f0f0f0;">
                                <td style="padding: 10px;"><%= p._id %></td>
                                <td style="text-align: right; padding: 10px; font-weight: bold;"><%= p.totalQty %></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
            <% } %>

            <!-- Últimas encomendas -->
            <% if (recentOrders && recentOrders.length > 0) { %>   <!-- Caso tenha feita uma encomenda é que isto aparece -->
            <section style="margin-top: 30px;">
                <h2 style="color: #1a237e; margin-bottom: 16px;">Últimas Encomendas</h2>
                <div style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                <!-- Tabela com as estatisticas das ultimas encomendas -->
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid #eee;">
                                <th style="text-align: left; padding: 10px; color: #666;">Supermercado</th>
                                <th style="text-align: left; padding: 10px; color: #666;">Estado</th>
                                <th style="text-align: right; padding: 10px; color: #666;">Total</th>
                                <th style="text-align: right; padding: 10px; color: #666;">Data</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% recentOrders.forEach(function(order) { %>
                            <tr style="border-bottom: 1px solid #f0f0f0;">
                                <td style="padding: 10px;"><%= order.supermarket ? order.supermarket.name : ' N/A' %>


                            </td>
                            <!-- Estado da encomenda -->
                            <td style="padding: 10px;">
                                <% 
                                    let statusClass = 'status-default';
                                    if (order.status === 'entregue') statusClass = 'status-entregue';
                                    else if (order.status === 'cancelada') statusClass = 'status-cancelada';
                                %>
                                <span class="status-badge-inline <%= statusClass %>">
                                    <!-- Se estiver entregue fica verde, se estiver cancelada fica vermelho, se estiver em processamento fica azul -->
                                    <%= order.status %>
                                </span>
                            </td>
                            <!-- Total da encomenda -->
                            <td style="text-align: right; padding: 10px; font-weight: bold;">
                                <%= order.totalAmount.toFixed(2) %> €
                                    <!-- Preço da encomenda com 2 casas decimais "toFixed(2)"-->
                            </td>
                            <!-- Data da encomenda -->
                            <td style="text-align: right; padding: 10px; color: #888;">
                                <%= order.createdAt.toLocaleDateString('pt-PT') %>
                                    <!-- Data da encomenda "toLocaleDateString('pt-PT')"-->
                            </td>
                            </tr>
                            <% }) %>
                                </tbody>
                                </table>
                </div>
            </section>
            <% } %>

        </main>

    </div>

</body>

</html>