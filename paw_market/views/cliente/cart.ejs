<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/stylesheets/main.css">
</head>

<body>

    <!-- Barra lateral -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <span class="brand-super">Supermarket</span>
            <span class="brand-hub">HUB</span>
        </div>
        <nav class="sidebar-nav">
            <a href="/cliente" class="sidebar-link">Início</a>
            <a href="/cliente/products" class="sidebar-link">Produtos</a>
            <a href="/cliente/cart" class="sidebar-link active">Carrinho</a>
            <a href="/cliente/orders" class="sidebar-link">Minhas Encomendas</a>
            <a href="/cliente/profile" class="sidebar-link">Perfil</a>
        </nav>
        <div class="sidebar-footer">
            <a href="/logout" class="sidebar-logout">Sair da Conta</a>
        </div>
    </aside>

    <!-- Conteúdo principal -->
    <div class="page-wrapper">
        <main class="main-container">

            <h1 style="color: #1a237e; margin-bottom: 24px;">Carrinho de Compras</h1>

            <% if (cartItems.length===0) { %>
                <div style="text-align: center; padding: 60px 20px;">
                    <p style="font-size: 18px; color: #888; margin-top: 16px;">O teu carrinho está vazio.</p>
                    <a href="/cliente/products"
                        style="display: inline-block; margin-top: 16px; padding: 12px 28px; background: #1a237e; color: white; border-radius: 8px; text-decoration: none; font-weight: 600;">
                        Ver Produtos
                    </a>
                </div>
                <% } else { %>

                    <div
                        style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="border-bottom: 2px solid #eee;">
                                    <th style="text-align: left; padding: 12px; color: #666; font-size: 13px;">Produto
                                    </th>
                                    <th style="text-align: left; padding: 12px; color: #666; font-size: 13px;">
                                        Supermercado</th>
                                    <th style="text-align: center; padding: 12px; color: #666; font-size: 13px;">Preço
                                    </th>
                                    <th style="text-align: center; padding: 12px; color: #666; font-size: 13px;">Qtd.
                                    </th>
                                    <th style="text-align: right; padding: 12px; color: #666; font-size: 13px;">Subtotal
                                    </th>
                                    <th style="text-align: center; padding: 12px; color: #666; font-size: 13px;">Ações
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <% cartItems.forEach(function(item) { %>
                                    <tr style="border-bottom: 1px solid #f0f0f0;">
                                        <td style="padding: 14px 12px;">
                                            <div style="display: flex; align-items: center; gap: 12px;">
                                                <div
                                                    style="width: 48px; height: 48px; background: #f0f2f5; border-radius: 8px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                                    <% if (item.product.image) { %>
                                                        <img src="<%= item.product.image %>" alt=""
                                                            style="width: 100%; height: 100%; object-fit: cover;">
                                                        <% } else { %>
                                                            <span style="font-size: 20px;">🛒</span>
                                                            <% } %>
                                                </div>
                                                <span style="font-weight: 600;">
                                                    <%= item.product.name %>
                                                </span>
                                            </div>
                                        </td>
                                        <td style="padding: 14px 12px; color: #666; font-size: 14px;">
                                            <%= item.product.supermarket ? item.product.supermarket.name : '' %>
                                        </td>
                                        <td style="text-align: center; padding: 14px 12px;">
                                            <%= item.product.price.toFixed(2) %> €
                                        </td>
                                        <td style="text-align: center; padding: 14px 12px;">
                                            <form method="POST" action="/cliente/cart/update"
                                                style="display: flex; align-items: center; justify-content: center; gap: 6px;">
                                                <input type="hidden" name="productId" value="<%= item.product._id %>">
                                                <input type="number" name="quantity" value="<%= item.quantity %>"
                                                    min="1" max="<%= item.product.stock %>"
                                                    style="width: 60px; padding: 6px; border: 1px solid #ddd; border-radius: 6px; text-align: center; font-size: 14px;">
                                                <button type="submit"
                                                    style="padding: 6px 10px; background: #e8eaf6; color: #1a237e; border: none; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600;">
                                                    ✓
                                                </button>
                                            </form>
                                        </td>
                                        <td
                                            style="text-align: right; padding: 14px 12px; font-weight: 700; color: #1a237e;">
                                            <%= item.subtotal.toFixed(2) %> €
                                        </td>
                                        <td style="text-align: center; padding: 14px 12px;">
                                            <a href="/cliente/cart/remove/<%= item.product._id %>"
                                                style="color: #c62828; text-decoration: none; font-weight: 600; font-size: 13px;">
                                                Remover
                                            </a>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>

                        <!-- TOTAL E CHECKOUT -->
                        <div
                            style="display: flex; justify-content: flex-end; align-items: center; gap: 24px; margin-top: 24px; padding-top: 20px; border-top: 2px solid #eee;">
                            <span style="font-size: 18px; color: #666;">Total:</span>
                            <span style="font-size: 28px; font-weight: 800; color: #1a237e;">
                                <%= total.toFixed(2) %> €
                            </span>
                            <a href="/cliente/checkout"
                                style="padding: 14px 36px; background: #1a237e; color: white; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 15px;">
                                Finalizar Encomenda
                            </a>
                        </div>
                    </div>

                    <% } %>

        </main>
    </div>

</body>

</html>