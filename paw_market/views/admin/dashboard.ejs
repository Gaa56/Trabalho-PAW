<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Painel de Administração - SupermarketHUB">
    <title>Dashboard Admin - SupermarketHUB</title>
    <link rel="stylesheet" href="/stylesheets/main.css">
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-brand">
            <span class="brand-super">Supermarket</span>
            <span class="brand-hub">HUB</span>
        </div>
        <nav class="sidebar-nav">
            <a href="/admin" class="sidebar-link active">&#128202; Dashboard</a>
            <a href="/admin/supermarkets" class="sidebar-link">&#127978; Supermercados</a>
            <a href="/admin/users" class="sidebar-link">&#128100; Utilizadores</a>
        </nav>
        <div class="sidebar-footer">
            <a href="/logout" class="sidebar-logout">&#128682; Sair da Conta</a>
        </div>
    </div>

    <div class="page-wrapper">
        <main class="main-container">
            <section class="hero-banner">
                <div class="hero-content">
                    <h1 class="hero-title">Painel Admin</h1>
                    <p style="color: #93c5fd; margin-top: 0.5rem;">Bem-vindo, <%= user.name.split(' ')[0] %></p>
                </div>
            </section>

            <section style="display: flex; gap: 20px; margin-top: 30px; flex-wrap: wrap;">
                <div style="background: white; border-radius: 12px; padding: 24px; flex: 1; min-width: 160px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                    <h3 style="margin: 0 0 8px 0; color: #666; font-size: 14px;">Total de Utilizadores</h3>
                    <p style="margin: 0; font-size: 32px; font-weight: bold; color: #1a237e;"><%= totalUsers %></p>
                </div>
                <div style="background: white; border-radius: 12px; padding: 24px; flex: 1; min-width: 160px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                    <h3 style="margin: 0 0 8px 0; color: #666; font-size: 14px;">Supermercados Ativos</h3>
                    <p style="margin: 0; font-size: 32px; font-weight: bold; color: #1a237e;"><%= totalSupermarkets %></p>
                </div>
                <div style="background: white; border-radius: 12px; padding: 24px; flex: 1; min-width: 160px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                    <h3 style="margin: 0 0 8px 0; color: #666; font-size: 14px;">Total de Encomendas</h3>
                    <p style="margin: 0; font-size: 32px; font-weight: bold; color: #1a237e;"><%= totalOrders %></p>
                </div>
                <div style="background: white; border-radius: 12px; padding: 24px; flex: 1; min-width: 160px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); border-left: 4px solid #f59e0b;">
                    <h3 style="margin: 0 0 8px 0; color: #666; font-size: 14px;">Aprovações Pendentes</h3>
                    <p style="margin: 0; font-size: 32px; font-weight: bold; color: #b45309;"><%= pendingApprovals %></p>
                </div>
            </section>

            <section style="margin-top: 30px;">
                <h2 style="color: #1a237e; margin-bottom: 16px;">Acesso Rápido</h2>
                <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                    <a href="/admin/supermarkets" style="background: white; border-radius: 12px; padding: 20px 28px; text-decoration: none; color: #1a237e; font-weight: 600; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                        &#127978; Gerir Supermercados
                    </a>
                    <a href="/admin/users" style="background: white; border-radius: 12px; padding: 20px 28px; text-decoration: none; color: #1a237e; font-weight: 600; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                        &#128100; Gerir Utilizadores
                    </a>
                </div>
            </section>
        </main>
    </div>
</body>
</html>
