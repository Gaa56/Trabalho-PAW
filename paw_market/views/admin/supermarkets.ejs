<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Gestão de Supermercados - Admin">
    <title>Supermercados - Admin - SupermarketHUB</title>
    <link rel="stylesheet" href="/stylesheets/main.css">
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-brand">
            <span class="brand-super">Supermarket</span>
            <span class="brand-hub">HUB</span>
        </div>
        <nav class="sidebar-nav">
            <a href="/admin" class="sidebar-link">&#128202; Dashboard</a>
            <a href="/admin/supermarkets" class="sidebar-link active">&#127978; Supermercados</a>
            <a href="/admin/users" class="sidebar-link">&#128100; Utilizadores</a>
        </nav>
        <div class="sidebar-footer">
            <a href="/logout" class="sidebar-logout">&#128682; Sair da Conta</a>
        </div>
    </div>

    <div class="page-wrapper">
        <main class="main-container">
            <h1 style="color: #1a237e; margin-bottom: 24px;">Gestão de Supermercados</h1>

            <% if (supermarkets.length === 0) { %>
                <div style="background: white; border-radius: 12px; padding: 40px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                    <p style="color: #666;">Nenhum supermercado registado ainda.</p>
                </div>
            <% } else { %>
                <div style="background: white; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid #eee;">
                                <th style="text-align: left; padding: 12px; color: #666; font-size: 14px;">Nome</th>
                                <th style="text-align: left; padding: 12px; color: #666; font-size: 14px;">Dono</th>
                                <th style="text-align: left; padding: 12px; color: #666; font-size: 14px;">Localização</th>
                                <th style="text-align: center; padding: 12px; color: #666; font-size: 14px;">Estado</th>
                                <th style="text-align: center; padding: 12px; color: #666; font-size: 14px;">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% supermarkets.forEach(function(s) { %>
                            <tr style="border-bottom: 1px solid #f0f0f0;">
                                <td style="padding: 12px; font-weight: 600;"><%= s.name %></td>
                                <td style="padding: 12px; color: #555;">
                                    <% if (s.owner) { %>
                                        <%= s.owner.name %><br>
                                        <span style="font-size: 12px; color: #888;"><%= s.owner.email %></span>
                                    <% } else { %><span style="color: #aaa;">N/A</span><% } %>
                                </td>
                                <td style="padding: 12px; color: #555;"><%= s.location ? s.location.address : '—' %></td>
                                <td style="padding: 12px; text-align: center;">
                                    <% if (s.isApproved) { %>
                                        <span style="background: #e8f5e9; color: #2e7d32; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: bold;">Aprovado</span>
                                    <% } else { %>
                                        <span style="background: #fff3e0; color: #e65100; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: bold;">Pendente</span>
                                    <% } %>
                                </td>
                                <td style="padding: 12px; text-align: center;">
                                    <% if (!s.isApproved) { %>
                                        <form action="/admin/supermarkets/<%= s._id %>/approve" method="POST" style="display:inline;">
                                            <button type="submit" style="background: #2e7d32; color: white; border: none; padding: 6px 14px; border-radius: 8px; cursor: pointer; font-size: 13px;">Aprovar</button>
                                        </form>
                                    <% } %>
                                    <% if (s.isApproved) { %>
                                        <form action="/admin/supermarkets/<%= s._id %>/reject" method="POST" style="display:inline;">
                                            <button type="submit" style="background: #c62828; color: white; border: none; padding: 6px 14px; border-radius: 8px; cursor: pointer; font-size: 13px;">Revogar</button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </main>
    </div>
</body>
</html>
