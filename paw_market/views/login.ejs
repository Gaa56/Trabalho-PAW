<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Login - MercadoPAW Marketplace">
    <!-- Titulo do site -->
    <title>Login - MercadoPAW</title>


    <!-- Stylesheet Global para Login e Registo -->
    <link rel="stylesheet" href="/stylesheets/auth.css">
</head>

<body>
    <div class="login-container">
        <!-- COLUNA ESQUERDA -->
        <!-- Imagem -->
        <div class="login-left">
            <!-- A imagem vai ocupar todo o espaço da coluna esquerda, caso nao renderize vai aparecer "Supermarket HUB" -->
            <img src="/images/Supermarket.png" alt="Supermarket HUB" class="login-left-image" id="login-hero-image">
        </div>

        <!-- COLUNA DIREITA -->
        <div class="login-right">
            <!-- Butão de criar conta -->
            <a href="/register" class="create-account-link" id="create-account-btn">Criar uma conta</a>

            <div class="login-form-wrapper">
                <!-- Titulo -->
                <h1 class="login-title" id="login-title">SuperMarket Hub</h1>
                <!-- Subtitulo -->
                <p class="login-subtitle">Inicia sessão na tua conta</p>

                <!-- Mensagem de erro -->
                <% if (typeof error !=='undefined' && error) { %>
                    <div class="error-message" id="login-error">

                        <span>
                            <%= error %>
                        </span>
                    </div>
                    <% } %>

                        <form action="/login" method="POST" id="login-form">
                            <div class="form-group">
                                <label for="email">Email</label>
                                <!-- Caixa de texto para o email -->
                                <input type="email" id="email" name="email" placeholder="exemplo@email.com" required>
                            </div>

                            <div class="form-group">
                                <label for="password">Password</label>
                                <div class="password-wrapper">
                                    <input type="password" id="password" name="password"
                                        placeholder="Introduz a tua password" required>
                                    <button type="button" class="toggle-password" id="toggle-password-btn"
                                        onclick="togglePassword()">
                                        <span id="eye-text">Mostrar</span>
                                    </button>
                                </div>
                            </div>



                            <!-- Botão de iniciar sessão do tipo submit -->
                            <button type="submit" class="btn-signin" id="signin-btn">
                                Sign in
                            </button>
                        </form>
            </div>


        </div>
    </div>

    <!-- Script para mostrar/esconder a password -->
    <script>
        function togglePassword() {
            // Vai buscar a caixa de texto da password e o texto do butão
            const passwordInput = document.getElementById('password');
            const eyeText = document.getElementById('eye-text');
            // Se a password for do tipo password, muda para texto e o texto do butão muda para "Ocultar"
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeText.textContent = 'Ocultar';
            } else {
                passwordInput.type = 'password';
                eyeText.textContent = 'Mostrar';
            }
        }
    </script>
</body>

</html>