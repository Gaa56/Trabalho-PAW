<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Login - MercadoPAW Marketplace">
    <!-- Titulo do site -->
    <title>Login - MercadoPAW</title>


    <style>
        /* ===== RESET ===== */
        /* O simbolo '*' refere-se a todos os elementos da pagina, o ::before e ::after referem-se a elementos que são criados dinamicamente */
        /* Isto serve para nao ficar umas colunas desiguais */
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        /* Estrutura inicial da pagina */
        body {
            /* Fonte */
            font-family: 'Inter', sans-serif;
            /* Cor de fundo padrão*/
            background-color: #f8f9fc;
            /* Impede que a pagina tenha scroll, vai cortar tudo que passar o limite de 100vh */
            overflow: hidden;
        }

        /* ===== LAYOUT PRINCIPAL - Duas Colunas ===== */
        /* Ocupar todo o ecra */
        .login-container {
            /* Alinhar todos os elementos */
            display: flex;
            /* Horizontal */
            width: 100%;
            /* Vertical */
            min-height: 100vh;
        }

        /* ===== COLUNA ESQUERDA - Azul Escuro ===== */
        .login-left {
            /* Ocupar 42% do ecra na horizontal */
            width: 42%;
            /* Cor de fundo */
            background: linear-gradient(160deg, #0a1628 0%, #0f2545 40%, #132d52 70%, #0a1628 100%);
            display: flex;

            /* Todos os elementos que metermos nesta coluna vao ser organizados em coluna, ou seja "um em cima do outro"*/
            flex-direction: column;


            /* Centralizar horizontalmente e verticalmente elementos que metermos nesta coluna*/
            align-items: center;
            justify-content: center;


            position: relative;
            overflow: hidden;
            /* Margem interna */
            padding: 3rem;
        }

        /* Imagem do supermercado */
        /* Vai ficar dentro da coluna da esquerda */
        .login-left-image {
            position: relative;

            z-index: 2;
            width: 95%;
            max-width: 820px;
            border-radius: 20px;
            object-fit: cover;
        }

        /* ===== COLUNA DIREITA - Formulário ===== */
        .login-right {
            width: 58%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem;
            position: relative;
            background-color: #f8f9fc;
        }

        /* Link de criar conta no canto superior direito */
        .create-account-link {
            position: absolute;
            /* Fica a 2rem do topo e a 2.5rem da direita */
            top: 2rem;
            right: 2.5rem;
            /* Remove o sublinhado do link */
            text-decoration: none;
            /* Cor do link */
            color: #0f2545;
            /* Tamanho da letra */
            font-size: 0.85rem;
            /* "Peso" da letra */
            font-weight: 500;
            /* Margem interna */
            padding: 0.55rem 1.3rem;
            /* Borda */
            border: 1.5px solid #d0d5dd;
            /* Cantos arredondados */
            border-radius: 8px;
            /* Transição */
            transition: all 0.3s ease;
        }

        /* Transição do butão ao passar o rato por cima */
        /* O :hover é o elemento que faz com que o butão mude quando o rato passa por cima */

        .create-account-link:hover {
            border-color: #0f2545;
            background-color: #0f2545;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(15, 37, 69, 0.2);
        }

        /* Caixa do formulário */
        .login-form-wrapper {
            width: 100%;
            max-width: 420px;
        }

        /* Titulo SuperMarket Hub */
        .login-title {
            font-size: 7.2rem;
            font-weight: 800;
            color: #0a1628;
            line-height: 1.1;
            margin-bottom: 0.8rem;
            letter-spacing: -2px;
        }

        /* Subtitulo "Iniciar sessão" */
        .login-subtitle {
            font-size: 1rem;
            color: #6b7280;
            font-weight: 400;
            margin-bottom: 2.5rem;
        }

        /* ===== MENSAGEM DE ERRO ===== */
        /* A caixa de texto */
        .error-message {
            /* Cor de fundo */
            background-color: #fef2f2;
            /* Tamanho e cor da Borda */
            border: 1px solid #fecaca;
            /* Cantos arredondados */
            border-radius: 10px;
            /* Margem interna */
            padding: 0.85rem 1.1rem;
            /* Um espaço vazio para separar do as caixas de */
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            /* Um espaço vazio entre o texto e o icone */
            gap: 0.6rem;
        }



        /* O texto */
        /* O span é a etiqueta responsavel por meter o texto em linha */
        .error-message span {
            font-size: 0.85rem;
            color: #991b1b;
            font-weight: 500;
        }

        /* ===== INPUTS ===== */
        .form-group {
            margin-bottom: 1.4rem;
        }

        .form-group label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: #344054;
            margin-bottom: 0.45rem;
            letter-spacing: 0.02em;
        }

        .form-group input {
            width: 100%;
            padding: 0.8rem 1rem;
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            color: #1a1a2e;
            background-color: #ffffff;
            border: 1.5px solid #d0d5dd;
            border-radius: 10px;
            outline: none;
            transition: all 0.25s ease;
        }

        .form-group input::placeholder {
            color: #9ca3af;
            font-weight: 300;
        }

        .form-group input:focus {
            border-color: #0f2545;
            box-shadow: 0 0 0 3px rgba(15, 37, 69, 0.1);
        }

        /* ===== PASSWORD WRAPPER ===== */
        .password-wrapper {
            position: relative;
        }

        .password-wrapper input {
            padding-right: 3rem;
        }

        .toggle-password {
            position: absolute;
            right: 0.85rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #9ca3af;
            transition: color 0.2s;
            display: flex;
            align-items: center;
        }

        .toggle-password:hover {
            color: #0f2545;
        }

        /* ===== OPÇÕES EXTRA ===== */
        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .remember-me {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
        }

        .remember-me input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: #0f2545;
            cursor: pointer;
        }

        .remember-me span {
            font-size: 0.82rem;
            color: #4b5563;
        }

        .forgot-password {
            font-size: 0.82rem;
            color: #0f2545;
            font-weight: 600;
            text-decoration: none;
            transition: opacity 0.2s;
        }

        .forgot-password:hover {
            opacity: 0.7;
        }

        /* ===== BOTÃO SIGN IN ===== */
        .btn-signin {
            width: 100%;
            padding: 0.85rem;
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            color: #ffffff;
            background: linear-gradient(135deg, #0f2545 0%, #1a3a6b 100%);
            border: none;
            border-radius: 10px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .btn-signin::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transition: left 0.5s ease;
        }

        .btn-signin:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(15, 37, 69, 0.35);
        }

        .btn-signin:hover::before {
            left: 100%;
        }

        .btn-signin:active {
            transform: translateY(0);
        }

        .btn-signin svg {
            width: 18px;
            height: 18px;
            transition: transform 0.3s ease;
        }

        .btn-signin:hover svg {
            transform: translateX(4px);
        }

        /* ===== FOOTER COLUNA DIREITA ===== */
        .login-footer {
            position: absolute;
            bottom: 2rem;
            text-align: center;
            font-size: 0.78rem;
            color: #9ca3af;
        }


        /* ===== RESPONSIVO ===== */
        @media (max-width: 900px) {
            .login-container {
                flex-direction: column;
            }

            .login-left {
                width: 100%;
                min-height: 280px;
                padding: 2rem;
            }

            .login-left-image {
                width: 50%;
                max-width: 220px;
            }

            .login-left-text {
                margin-top: 1.2rem;
            }

            .login-left-text h2 {
                font-size: 1.1rem;
            }

            .login-right {
                width: 100%;
                padding: 2rem 1.5rem;
            }

            .login-title {
                font-size: 2.4rem;
            }

            .create-account-link {
                position: static;
                display: block;
                text-align: center;
                margin-bottom: 1.5rem;
            }
        }
    </style>
</head>

<body>
    <div class="login-container">
        <!-- COLUNA ESQUERDA -->
        <div class="login-left">
            <img src="/images/Supermarket.png" alt="MercadoPAW" class="login-left-image" id="login-hero-image">
        </div>

        <!-- COLUNA DIREITA -->
        <div class="login-right">
            <a href="/register" class="create-account-link" id="create-account-btn">Criar uma conta</a>

            <div class="login-form-wrapper">
                <h1 class="login-title" id="login-title">SuperMarket Hub</h1>
                <p class="login-subtitle">Inicia sessão na tua conta</p>

                <% if (typeof error !=='undefined' && error) { %>
                    <div class="error-message" id="login-error">

                        <span>
                            <%= error %>
                        </span>
                    </div>
                    <% } %>

                        <form action="/login" method="POST" id="login-form">
                            <div class="form-group">
                                <label for="email">Email</label>
                                <input type="email" id="email" name="email" placeholder="exemplo@email.com" required>
                            </div>

                            <div class="form-group">
                                <label for="password">Password</label>
                                <div class="password-wrapper">
                                    <input type="password" id="password" name="password"
                                        placeholder="Introduz a tua password" required>
                                    <button type="button" class="toggle-password" id="toggle-password-btn"
                                        onclick="togglePassword()">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round" id="eye-icon">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    </button>
                                </div>
                            </div>



                            <button type="submit" class="btn-signin" id="signin-btn">
                                Sign in
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </button>
                        </form>
            </div>


        </div>
    </div>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const eyeIcon = document.getElementById('eye-icon');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                passwordInput.type = 'password';
                eyeIcon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
            }
        }
    </script>
</body>

</html>