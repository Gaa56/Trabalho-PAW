<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produtos - Supermercado</title>
    <link rel="stylesheet" href="/stylesheets/main.css">
    <style>
        .btn-primary { padding: 10px 16px; background: #1a237e; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; text-decoration: none; display: inline-block; }
        .btn-primary:hover { background: #0d1558; }
        .btn-secondary { padding: 8px 12px; background: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; }
        .btn-danger { padding: 8px 12px; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; }
        .btn-danger:hover { background: #c82333; }
        .product-card { border: 1px solid #ddd; border-radius: 8px; padding: 15px; margin-bottom: 15px; background: white; }
        .product-header { display: flex; justify-content: space-between; align-items: start; margin-bottom: 10px; }
        .product-actions { display: flex; gap: 8px; }
        .stock-available { color: #1a237e; }
        .stock-unavailable { color: #dc3545; }
        .status-active { color: #28a745; }
        .status-inactive { color: #dc3545; }
    </style>
</head>

<body>

    <!-- Barra lateral -->
    <div class="sidebar">
        <div class="sidebar-brand">
            <span class="brand-super">Supermarket</span>
            <span class="brand-hub">HUB</span>
        </div>

        <nav class="sidebar-nav">
            <a href="/supermarket" class="sidebar-link">Dashboard</a>
            <a href="/supermarket/profile" class="sidebar-link">Perfil</a>
            <a href="/supermarket/products" class="sidebar-link active">Produtos</a>
            <a href="/supermarket/pos" class="sidebar-link">Ponto de Venda</a>
        </nav>

        <div class="sidebar-footer">
            <a href="/logout" class="sidebar-logout">Sair da Conta</a>
        </div>
    </div>

    <!-- Conteúdo principal -->
    <div class="page-wrapper">
        <main class="main-container">

            <section class="hero-banner">
                <div class="hero-content">
                    <h1 class="hero-title">Gestão de Produtos</h1>
                    <p style="color: #666; font-size: 16px; margin-top: 8px;">Adicionar, editar e gerir os produtos da sua loja</p>
                </div>
            </section>

            <!-- Botão Adicionar Produto -->
            <div style="margin-top: 30px; margin-bottom: 20px;">
                <a href="/supermarket/products/new" class="btn-primary">+ Adicionar Novo Produto</a>
            </div>

            <!-- Lista de Produtos -->
            <% if (products && products.length > 0) { %>
                <div style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                    
                    <% products.forEach(function(product) { %>
                        <div class="product-card">
                            <div class="product-header">
                                <div>
                                    <h3 style="margin: 0 0 5px 0; color: #1a237e;"><%= product.name %></h3>
                                    <p style="margin: 0; color: #666; font-size: 14px;"><%= product.category && product.category.name ? product.category.name : 'Sem categoria' %></p>
                                </div>
                                <div class="product-actions">
                                    <a href="/supermarket/products/<%= product._id %>/edit" class="btn-secondary">Editar</a>
                                    <form method="POST" action="/supermarket/products/<%= product._id %>/delete" style="display: inline;">
                                        <button type="submit" class="btn-danger" onclick="return confirm('Tem certeza?')">Eliminar</button>
                                    </form>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; margin-top: 12px; padding-top: 12px; border-top: 1px solid #eee;">
                                <div>
                                    <small style="color: #999; display: block; margin-bottom: 5px;">Preço</small>
                                    <p style="margin: 0; font-size: 18px; font-weight: bold; color: #28a745;"><%= product.price.toFixed(2) %>€</p>
                                </div>
                                <div>
                                    <small style="color: #999; display: block; margin-bottom: 5px;">Stock</small>
                                    <p style="margin: 0; font-size: 18px; font-weight: bold;" class="<%= product.stock > 0 ? 'stock-available' : 'stock-unavailable' %>">
                                        <%= product.stock %> unidades
                                    </p>
                                </div>
                                <div>
                                    <small style="color: #999; display: block; margin-bottom: 5px;">Estado</small>
                                    <p style="margin: 0; font-size: 14px; font-weight: 600;" class="<%= product.isActive ? 'status-active' : 'status-inactive' %>">
                                        <%= product.isActive ? '✓ Ativo' : '✗ Inativo' %>
                                    </p>
                                </div>
                            </div>

                            <% if (product.description) { %>
                                <p style="margin: 12px 0 0 0; color: #666; font-size: 14px;"><%= product.description %></p>
                            <% } %>
                        </div>
                    <% }) %>

                </div>
            <% } else { %>
                <div style="background: #f8f9fa; border-radius: 12px; padding: 40px; text-align: center; color: #666; margin-top: 30px;">
                    <h3 style="margin: 0 0 10px 0;">Nenhum produto registado</h3>
                    <p style="margin: 0; margin-bottom: 20px;">Comece a adicionar produtos para a sua loja.</p>
                    <a href="/supermarket/products/new" class="btn-primary">Adicionar Primeiro Produto</a>
                </div>
            <% } %>

        </main>
    </div>

</body>

</html>
