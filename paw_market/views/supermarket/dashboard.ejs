<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Dashboard Supermercado - SupermarketHUB">
    <title>Dashboard - SupermarketHUB</title>
    <link rel="stylesheet" href="/stylesheets/main.css">
    <style>
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        .status-entregue { background-color: #d4edda; color: #155724; }
        .status-em-entrega { background-color: #fff3cd; color: #856404; }
        .status-confirmada { background-color: #d1ecf1; color: #0c5460; }
        .status-cancelada { background-color: #f8d7da; color: #721c24; }
        .status-pendente { background-color: #e2e3e5; color: #383d41; }
        .status-approved { color: #28a745; }
        .status-pending { color: #dc3545; }
    </style>
</head>
<body>
    <!-- Barra lateral -->
    <div class="sidebar">
        <div class="sidebar-brand">
            <span class="brand-super">Supermarket</span>
            <span class="brand-hub">HUB</span>
        </div>
        <nav class="sidebar-nav">
            <a href="/supermarket" class="sidebar-link active">Dashboard</a>
            <a href="/supermarket/profile" class="sidebar-link">Perfil</a>
            <a href="/supermarket/products" class="sidebar-link">Produtos</a>
            <a href="/supermarket/orders" class="sidebar-link">Encomendas</a>
            <a href="/supermarket/pos" class="sidebar-link">Ponto de Venda</a>
        </nav>
        <div class="sidebar-footer">
            <a href="/logout" class="sidebar-logout">Sair da Conta</a>
        </div>
    </div>

    <!-- Conteúdo principal -->
    <div class="page-wrapper">
        <main class="main-container">

            <% if (!superm) { %>
                <div style="background: #f8d7da; border-radius: 12px; padding: 20px; color: #721c24; text-align: center; margin-top: 30px;">
                    <h2 style="margin: 0 0 10px 0;">Erro ao carregar supermercado</h2>
                    <p style="margin: 0;">Não foi possível encontrar o perfil do seu supermercado. Por favor, contacte o administrador.</p>
                </div>
            <% } else { %>

            <!-- Banner de boas-vindas -->
            <section class="hero-banner">
                <div class="hero-content">
                    <h1 class="hero-title">Bem-vindo, <%= superm && superm.name ? superm.name : (user && user.name ? user.name.split(' ')[0] : 'Supermercado') %>!</h1>
                    <p style="color: #93c5fd; font-size: 16px; margin-top: 8px;">Gerencie seus produtos e encomendas</p>
                </div>
            </section>

            <!-- Cards de Estatísticas -->
            <section style="display: flex; gap: 20px; margin-top: 30px; flex-wrap: wrap;">
                <a href="/supermarket/products" style="background: white; border-radius: 12px; padding: 28px; flex: 1; min-width: 180px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); text-decoration: none; color: #1a237e; display: block;">
                    <p style="margin: 0; font-size: 14px; color: #666;">Gerir Produtos</p>
                    <p style="margin: 8px 0 0; font-size: 20px; font-weight: 700;">Ver Produtos</p>
                </a>
                <a href="/supermarket/orders" style="background: white; border-radius: 12px; padding: 28px; flex: 1; min-width: 180px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); text-decoration: none; color: #1a237e; display: block;">
                    <p style="margin: 0; font-size: 14px; color: #666;">Encomendas Recebidas</p>
                    <p style="margin: 8px 0 0; font-size: 20px; font-weight: 700;">Ver Encomendas</p>
                </a>
                <a href="/supermarket/pos" style="background: white; border-radius: 12px; padding: 28px; flex: 1; min-width: 180px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); text-decoration: none; color: #1a237e; display: block;">
                    <p style="margin: 0; font-size: 14px; color: #666;">Venda em Caixa</p>
                    <p style="margin: 8px 0 0; font-size: 20px; font-weight: 700;">Abrir POS</p>
                </a>
                <a href="/supermarket/profile" style="background: white; border-radius: 12px; padding: 28px; flex: 1; min-width: 180px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); text-decoration: none; color: #1a237e; display: block;">
                    <p style="margin: 0; font-size: 14px; color: #666;">Configurações</p>
                    <p style="margin: 8px 0 0; font-size: 20px; font-weight: 700;">Editar Perfil</p>
                </a>
            </section>

            <!-- Produtos mais vendidos -->
            <% if (typeof topProducts !== 'undefined' && topProducts.length > 0) { %>
            <section style="margin-top: 30px;">
                <h2 style="color: #1a237e; margin-bottom: 16px;">Produtos Mais Vendidos</h2>
                <div style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid #eee;">
                                <th style="text-align: left; padding: 12px; color: #666; font-weight: 600;">Produto</th>
                                <th style="text-align: right; padding: 12px; color: #666; font-weight: 600;">Quantidade Vendida</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% topProducts.forEach(function(p) { %>
                            <tr style="border-bottom: 1px solid #f0f0f0;">
                                <td style="padding: 12px; color: #333;"><%= p._id %></td>
                                <td style="text-align: right; padding: 12px; font-weight: bold; color: #28a745;"><%= p.totalQty %> unidades</td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
            <% } else { %>
            <section style="margin-top: 30px;">
                <div style="background: white; border-radius: 12px; padding: 30px; text-align: center; color: #666; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                    <p style="margin: 0; font-size: 16px;">Nenhuma venda registrada ainda.</p>
                </div>
            </section>
            <% } %>

            <!-- Últimas encomendas -->
            <% if (typeof recentOrders !== 'undefined' && recentOrders.length > 0) { %>
            <section style="margin-top: 30px; margin-bottom: 30px;">
                <h2 style="color: #1a237e; margin-bottom: 16px;">Últimas Encomendas</h2>
                <div style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid #eee;">
                                <th style="text-align: left; padding: 12px; color: #666; font-weight: 600;">Cliente</th>
                                <th style="text-align: left; padding: 12px; color: #666; font-weight: 600;">Estado</th>
                                <th style="text-align: right; padding: 12px; color: #666; font-weight: 600;">Total</th>
                                <th style="text-align: left; padding: 12px; color: #666; font-weight: 600;">Data</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentOrders.forEach(function(order) { %>
                            <tr style="border-bottom: 1px solid #f0f0f0;">
                                <td style="padding: 12px; color: #333;"><%= order.customer ? order.customer.name : 'Cliente Anónimo' %></td>
                                <td style="padding: 12px;">
                                    <% 
                                        let statusClass = 'status-pendente';
                                        if (order.status === 'entregue') statusClass = 'status-entregue';
                                        else if (order.status === 'em entrega' || order.status === 'em preparação') statusClass = 'status-em-entrega';
                                        else if (order.status === 'confirmada') statusClass = 'status-confirmada';
                                        else if (order.status === 'cancelada') statusClass = 'status-cancelada';
                                    %>
                                    <span class="status-badge <%= statusClass %>">
                                        <%= order.status %>
                                    </span>
                                </td>
                                <td style="padding: 12px; text-align: right; font-weight: bold; color: #1a237e;"><%= order.totalAmount.toFixed(2) %>€</td>
                                <td style="padding: 12px; color: #666; font-size: 14px;">
                                    <% 
                                        const dataFormatada = new Date(order.createdAt);
                                        const dia = String(dataFormatada.getDate()).padStart(2, '0');
                                        const mes = String(dataFormatada.getMonth() + 1).padStart(2, '0');
                                        const ano = dataFormatada.getFullYear();
                                    %>
                                    <%= dia %>/<%= mes %>/<%= ano %>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
            <% } else { %>
            <section style="margin-top: 30px; margin-bottom: 30px;">
                <div style="background: white; border-radius: 12px; padding: 30px; text-align: center; color: #666; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                    <p style="margin: 0; font-size: 16px;">Nenhuma encomenda ainda.</p>
                </div>
            </section>
            <% } %>

            <% } %>

        </main>
    </div>
</body>
</html>
