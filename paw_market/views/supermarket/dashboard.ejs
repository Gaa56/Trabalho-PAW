<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Dashboard Supermercado - SupermarketHUB">
    <title>Dashboard - SupermarketHUB</title>
    <link rel="stylesheet" href="/stylesheets/main.css">
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-brand">
            <span class="brand-super">Supermarket</span>
            <span class="brand-hub">HUB</span>
        </div>
        <nav class="sidebar-nav">
            <a href="/supermarket" class="sidebar-link active">&#128202; Dashboard</a>
            <a href="/supermarket/profile" class="sidebar-link">&#127978; Perfil</a>
            <a href="/supermarket/products" class="sidebar-link">&#128722; Produtos</a>
            <a href="/supermarket/orders" class="sidebar-link">&#128203; Encomendas</a>
            <a href="/supermarket/pos" class="sidebar-link">&#128180; Ponto de Venda</a>
        </nav>
        <div class="sidebar-footer">
            <a href="/logout" class="sidebar-logout">&#128682; Sair da Conta</a>
        </div>
    </div>

    <div class="page-wrapper">
        <main class="main-container">
            <section class="hero-banner">
                <div class="hero-content">
                    <h1 class="hero-title">Bem-vindo, <%= user.name.split(' ')[0] %>!</h1>
                    <p style="color: #93c5fd; margin-top: 0.5rem;">Painel do Supermercado</p>
                </div>
            </section>

            <section style="display: flex; gap: 16px; margin-top: 30px; flex-wrap: wrap;">
                <a href="/supermarket/products" style="background: white; border-radius: 12px; padding: 28px; flex: 1; min-width: 180px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); text-decoration: none; color: #1a237e; display: block;">
                    <p style="margin: 0; font-size: 14px; color: #666;">Gerir Produtos</p>
                    <p style="margin: 8px 0 0; font-size: 20px; font-weight: 700;">&#128722; Ver Produtos</p>
                </a>
                <a href="/supermarket/orders" style="background: white; border-radius: 12px; padding: 28px; flex: 1; min-width: 180px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); text-decoration: none; color: #1a237e; display: block;">
                    <p style="margin: 0; font-size: 14px; color: #666;">Encomendas Recebidas</p>
                    <p style="margin: 8px 0 0; font-size: 20px; font-weight: 700;">&#128203; Ver Encomendas</p>
                </a>
                <a href="/supermarket/pos" style="background: white; border-radius: 12px; padding: 28px; flex: 1; min-width: 180px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); text-decoration: none; color: #1a237e; display: block;">
                    <p style="margin: 0; font-size: 14px; color: #666;">Venda em Caixa</p>
                    <p style="margin: 8px 0 0; font-size: 20px; font-weight: 700;">&#128180; Abrir POS</p>
                </a>
                <a href="/supermarket/profile" style="background: white; border-radius: 12px; padding: 28px; flex: 1; min-width: 180px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); text-decoration: none; color: #1a237e; display: block;">
                    <p style="margin: 0; font-size: 14px; color: #666;">Configurações</p>
                    <p style="margin: 8px 0 0; font-size: 20px; font-weight: 700;">&#9881;&#65039; Editar Perfil</p>
                </a>
            </section>
        </main>
    </div>
</body>
</html>
