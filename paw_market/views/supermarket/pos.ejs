<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ponto de Venda - Supermercado</title>
    <link rel="stylesheet" href="/stylesheets/main.css">
    <style>
        .pos-container { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 30px; }
        @media (max-width: 1200px) { .pos-container { grid-template-columns: 1fr; } }
        .pos-section { background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
        .product-item { border: 1px solid #ddd; border-radius: 8px; padding: 12px; margin-bottom: 10px; cursor: pointer; transition: all 0.2s; }
        .product-item:hover { background: #f0f7ff; border-color: #1a237e; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; color: #333; font-weight: 600; font-size: 14px; }
        .form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; box-sizing: border-box; }
        .btn-add { background: #28a745; color: white; padding: 10px 16px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; margin-top: 10px; }
        .btn-add:hover { background: #218838; }
        .btn-finalize { background: #1a237e; color: white; padding: 12px 24px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; width: 100%; margin-top: 20px; }
        .cart-item { display: flex; justify-content: space-between; align-items: center; padding: 12px; background: #f8f9fa; border-radius: 6px; margin-bottom: 10px; }
        .cart-total { background: #1a237e; color: white; padding: 15px; border-radius: 6px; margin-top: 20px; text-align: right; }
        .cart-total p { margin: 8px 0; }
        .total-amount { font-size: 24px; font-weight: bold; }
    </style>
</head>

<body>

    <!-- Barra lateral -->
    <div class="sidebar">
        <div class="sidebar-brand">
            <span class="brand-super">Supermarket</span>
            <span class="brand-hub">HUB</span>
        </div>

        <nav class="sidebar-nav">
            <a href="/supermarket" class="sidebar-link">Dashboard</a>
            <a href="/supermarket/profile" class="sidebar-link">Perfil</a>
            <a href="/supermarket/products" class="sidebar-link">Produtos</a>
            <a href="/supermarket/orders" class="sidebar-link">Encomendas</a>
            <a href="/supermarket/pos" class="sidebar-link active">Ponto de Venda</a>
        </nav>

        <div class="sidebar-footer">
            <a href="/logout" class="sidebar-logout">Sair da Conta</a>
        </div>
    </div>

    <!-- Conteúdo principal -->
    <div class="page-wrapper">
        <main class="main-container">

            <section class="hero-banner">
                <div class="hero-content">
                    <h1 class="hero-title">Ponto de Venda</h1>
                    <p style="color: #666; font-size: 16px; margin-top: 8px;">Registar vendas em caixa</p>
                </div>
            </section>

            <div class="pos-container">

                <!-- Coluna 1: Dados do Cliente e Produtos -->
                <div>
                    <!-- Dados do Cliente -->
                    <div class="pos-section" style="margin-bottom: 20px;">
                        <h2 style="color: #1a237e; margin: 0 0 15px 0; font-size: 18px;">Dados do Cliente</h2>

                        <form id="posForm">
                            <div class="form-group">
                                <label>NIF do Cliente</label>
                                <input type="text" id="clientNif" name="clientNif" placeholder="9 dígitos">
                            </div>

                            <div class="form-group">
                                <label>Nome do Cliente</label>
                                <input type="text" id="clientName" name="clientName" placeholder="Consumidor final">
                            </div>

                            <h2 style="color: #1a237e; margin: 25px 0 15px 0; font-size: 18px;">Adicionar Produtos</h2>

                            <div class="form-group">
                                <label>Selecione um Produto</label>
                                <select id="productSelect" name="productId">
                                    <option value="">-- Selecione um produto --</option>
                                    <% if (products && products.length > 0) { %>
                                        <% products.forEach(function(product) { %>
                                            <option value="<%= product._id %>" data-price="<%= product.price %>" data-stock="<%= product.stock %>">
                                                <%= product.name %> - <%= product.price.toFixed(2) %>€ (Stock: <%= product.stock %>)
                                            </option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>

                            <div class="form-group">
                                <label>Quantidade</label>
                                <input type="number" id="quantity" name="quantity" min="1" value="1" required>
                            </div>

                            <button type="button" class="btn-add" onclick="addToCart()">+ Adicionar ao Carrinho</button>
                        </form>
                    </div>

                </div>

                <!-- Coluna 2: Carrinho e Checkout -->
                <div>
                    <!-- Carrinho -->
                    <div class="pos-section">
                        <h2 style="color: #1a237e; margin: 0 0 15px 0; font-size: 18px;">Carrinho</h2>

                        <div id="cartItems" style="max-height: 400px; overflow-y: auto;">
                            <p style="color: #999; text-align: center; padding: 20px;">Carrinho vazio</p>
                        </div>

                        <div class="cart-total" id="cartTotal" style="display: none;">
                            <p style="margin: 0;">Subtotal:</p>
                            <p id="subtotal" style="margin: 0; font-size: 18px;">0.00€</p>
                            <p style="margin: 0; margin-top: 10px; border-top: 1px solid rgba(255,255,255,0.3); padding-top: 10px;">Total:</p>
                            <p class="total-amount" id="totalAmount" style="margin: 0;">0.00€</p>
                        </div>

                        <button class="btn-finalize" onclick="finalizeSale()" id="finalizeBtn" style="display: none;">Finalizar Venda</button>
                    </div>
                </div>

            </div>

        </main>
    </div>

    <script>
        let cart = [];

        function addToCart() {
            const productSelect = document.getElementById('productSelect');
            const quantityInput = document.getElementById('quantity');
            const clientNif = document.getElementById('clientNif');
            const clientName = document.getElementById('clientName');

            if (!productSelect.value || !quantityInput.value) {
                alert('Por favor, preencha todos os campos obrigatórios');
                return;
            }

            const selectedOption = productSelect.options[productSelect.selectedIndex];
            const quantity = parseInt(quantityInput.value);
            const stock = parseInt(selectedOption.getAttribute('data-stock'));

            if (quantity > stock) {
                alert(`Stock insuficiente. Disponível: ${stock} unidades`);
                return;
            }

            const item = {
                productId: productSelect.value,
                name: selectedOption.text.split(' - ')[0],
                price: parseFloat(selectedOption.getAttribute('data-price')),
                quantity: quantity
            };

            cart.push(item);
            updateCart();
            productSelect.value = '';
            quantityInput.value = '1';
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCart();
        }

        function updateCart() {
            const cartItemsDiv = document.getElementById('cartItems');
            const cartTotalDiv = document.getElementById('cartTotal');
            const finalizeBtn = document.getElementById('finalizeBtn');

            if (cart.length === 0) {
                cartItemsDiv.innerHTML = '<p style="color: #999; text-align: center; padding: 20px;">Carrinho vazio</p>';
                cartTotalDiv.style.display = 'none';
                finalizeBtn.style.display = 'none';
                return;
            }

            let html = '';
            let total = 0;

            cart.forEach((item, index) => {
                const itemTotal = item.price * item.quantity;
                total += itemTotal;
                html += `
                    <div class="cart-item">
                        <div>
                            <p style="margin: 0; font-weight: 600; color: #333;">${item.name}</p>
                            <small style="color: #999;">
                                ${item.quantity}x ${item.price.toFixed(2)}€ = ${itemTotal.toFixed(2)}€
                            </small>
                        </div>
                        <button onclick="removeFromCart(${index})" style="background: #dc3545; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 12px;">Remover</button>
                    </div>
                `;
            });

            cartItemsDiv.innerHTML = html;
            document.getElementById('subtotal').textContent = total.toFixed(2) + '€';
            document.getElementById('totalAmount').textContent = total.toFixed(2) + '€';
            cartTotalDiv.style.display = 'block';
            finalizeBtn.style.display = 'block';
        }

        function finalizeSale() {
            const clientNif = document.getElementById('clientNif').value;
            const clientName = document.getElementById('clientName').value;

            if (cart.length === 0) {
                alert('Adicione produtos ao carrinho');
                return;
            }

            // Submeter cada item como uma venda separada
            cart.forEach(item => {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/supermarket/pos';

                form.innerHTML = `
                    <input type="hidden" name="clientNif" value="${clientNif}">
                    <input type="hidden" name="clientName" value="${clientName}">
                    <input type="hidden" name="productId" value="${item.productId}">
                    <input type="hidden" name="quantity" value="${item.quantity}">
                `;

                document.body.appendChild(form);
                form.submit();
                document.body.removeChild(form);
            });

            // Limpar carrinho após submissão
            setTimeout(() => {
                cart = [];
                document.getElementById('clientNif').value = '';
                document.getElementById('clientName').value = '';
                updateCart();
                alert('Venda registada com sucesso!');
            }, 1000);
        }
    </script>

</body>

</html>
