<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil - Supermercado</title>
    <link rel="stylesheet" href="/stylesheets/main.css">
    <style>
        .status-approved { background: #d4edda; border-radius: 8px; padding: 15px; margin-bottom: 30px; color: #155724; }
        .status-pending { background: #fff3cd; border-radius: 8px; padding: 15px; margin-bottom: 30px; color: #856404; }
    </style>
</head>

<body>

    <!-- Barra lateral -->
    <div class="sidebar">
        <div class="sidebar-brand">
            <span class="brand-super">Supermarket</span>
            <span class="brand-hub">HUB</span>
        </div>

        <nav class="sidebar-nav">
            <a href="/supermarket" class="sidebar-link">Dashboard</a>
            <a href="/supermarket/profile" class="sidebar-link active">Perfil</a>
            <a href="/supermarket/products" class="sidebar-link">Produtos</a>
            <a href="/supermarket/orders" class="sidebar-link">Encomendas</a>
            <a href="/supermarket/pos" class="sidebar-link">Ponto de Venda</a>
        </nav>

        <div class="sidebar-footer">
            <a href="/logout" class="sidebar-logout">Sair da Conta</a>
        </div>
    </div>

    <!-- Conteúdo principal -->
    <div class="page-wrapper">
        <main class="main-container">

            <section class="hero-banner">
                <div class="hero-content">
                    <h1 class="hero-title">Perfil do Supermercado</h1>
                    <p style="color: #666; font-size: 16px; margin-top: 8px;">Gerencie as informações da sua loja</p>
                </div>
            </section>

            <% if (!superm) { %>
                <div style="background: #f8d7da; border-radius: 12px; padding: 20px; color: #721c24; margin-top: 30px;">
                    <p style="margin: 0;">Erro ao carregar perfil do supermercado.</p>
                </div>
            <% } else { %>

                <div style="background: white; border-radius: 12px; padding: 30px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-top: 30px; margin-bottom: 30px;">
                    
                    <form method="POST" action="/supermarket/profile">
                        
                        <!-- Informações Básicas -->
                        <h2 style="color: #1a237e; margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px;">Informações Básicas</h2>

                        <div style="margin-bottom: 20px;">
                            <label style="display: block; margin-bottom: 8px; color: #333; font-weight: 600;">Nome do Supermercado</label>
                            <input type="text" value="<%= superm.name %>" disabled style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; background: #f5f5f5; color: #666;">
                            <small style="color: #999; display: block; margin-top: 5px;">Campo apenas para leitura</small>
                        </div>

                        <div style="margin-bottom: 20px;">
                            <label style="display: block; margin-bottom: 8px; color: #333; font-weight: 600;">Descrição</label>
                            <textarea name="description" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-family: Arial; font-size: 14px; resize: vertical; min-height: 100px;"><%= superm.description || '' %></textarea>
                        </div>

                        <!-- Localização -->
                        <h2 style="color: #1a237e; margin-top: 30px; margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px;">Localização</h2>

                        <div style="margin-bottom: 20px;">
                            <label style="display: block; margin-bottom: 8px; color: #333; font-weight: 600;">Endereço</label>
                            <input type="text" value="<%= superm.location && superm.location.address ? superm.location.address : '' %>" disabled style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; background: #f5f5f5; color: #666;">
                            <small style="color: #999; display: block; margin-top: 5px;">Campo apenas para leitura</small>
                        </div>

                        <!-- Entrega -->
                        <h2 style="color: #1a237e; margin-top: 30px; margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px;">Métodos de Entrega</h2>

                        <div style="display: flex; gap: 20px; margin-bottom: 20px;">
                            <div style="display: flex; align-items: center;">
                                <input type="checkbox" id="pickup" <%= superm.deliveryMethods && superm.deliveryMethods.pickup ? 'checked' : '' %> disabled style="margin-right: 8px; cursor: pointer;">
                                <label for="pickup" style="color: #333; font-weight: 600; cursor: pointer;">Levantamento em Loja</label>
                            </div>
                            <div style="display: flex; align-items: center;">
                                <input type="checkbox" id="courier" <%= superm.deliveryMethods && superm.deliveryMethods.courier ? 'checked' : '' %> disabled style="margin-right: 8px; cursor: pointer;">
                                <label for="courier" style="color: #333; font-weight: 600; cursor: pointer;">Entrega por Estafeta</label>
                            </div>
                        </div>

                        <div style="margin-bottom: 20px;">
                            <label style="display: block; margin-bottom: 8px; color: #333; font-weight: 600;">Custo de Entrega (€)</label>
                            <input type="number" name="deliveryCost" step="0.01" min="0" value="<%= superm.deliveryCost || 0 %>" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px;">
                        </div>

                        <!-- Horários -->
                        <h2 style="color: #1a237e; margin-top: 30px; margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px;">Horário de Funcionamento</h2>

                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px;">
                            <% const dias = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
                               const nomeDias = ['Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado', 'Domingo'];
                            %>
                            <% dias.forEach((dia, idx) => { %>
                                <div style="border: 1px solid #ddd; padding: 15px; border-radius: 8px; background: #f9f9f9;">
                                    <p style="margin: 0 0 10px 0; color: #333; font-weight: 600;"><%= nomeDias[idx] %></p>
                                    <div style="margin-bottom: 8px;">
                                        <input type="time" value="<%= superm.openingHours && superm.openingHours[dia] ? superm.openingHours[dia].open : '08:00' %>" disabled style="width: 100%; padding: 6px; border: 1px solid #ddd; border-radius: 4px; background: #f5f5f5;">
                                    </div>
                                    <small style="color: #999;">Abre</small>
                                    <div style="margin-bottom: 8px;">
                                        <input type="time" value="<%= superm.openingHours && superm.openingHours[dia] ? superm.openingHours[dia].close : '20:00' %>" disabled style="width: 100%; padding: 6px; border: 1px solid #ddd; border-radius: 4px; background: #f5f5f5;">
                                    </div>
                                    <small style="color: #999;">Fecha</small>
                                </div>
                            <% }) %>
                        </div>

                        <!-- Status de Aprovação -->
                        <h2 style="color: #1a237e; margin-top: 30px; margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px;">Estado</h2>

                        <div class="<%= superm.isApproved ? 'status-approved' : 'status-pending' %>">
                            <p style="margin: 0; font-weight: 600;">
                                <%= superm.isApproved ? '✓ Supermercado Aprovado' : '⏳ Pendente de Aprovação do Administrador' %>
                            </p>
                        </div>

                        <!-- Botões -->
                        <div style="display: flex; gap: 10px;">
                            <button type="submit" style="padding: 12px 24px; background: #1a237e; color: white; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; font-size: 16px;">Guardar Alterações</button>
                            <a href="/supermarket" style="padding: 12px 24px; background: #6c757d; color: white; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; text-align: center;">Cancelar</a>
                        </div>

                    </form>

                </div>

            <% } %>

        </main>
    </div>

</body>

</html>
